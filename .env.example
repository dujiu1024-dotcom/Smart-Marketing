# Copy to .env for local development. Never commit real credentials.
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://store_operator:change-me-locally@localhost:5432/store_operator
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173
# Local development only; production must set a random pepper (32+ chars) and approve session timeouts.
SESSION_TOKEN_PEPPER=local-development-only-change-me
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_ABSOLUTE_TIMEOUT_SECONDS=86400
# Optional OTLP HTTP traces endpoint, e.g. http://otel-collector:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Private S3-compatible object storage (local SeaweedFS or approved managed provider).
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:8333\n# Browser-visible endpoint used only to create presigned URLs. Keep this reachable from the browser.\nOBJECT_STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:8333
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=store-operator-private
OBJECT_STORAGE_ACCESS_KEY_ID=local-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=local-secret-key
OBJECT_STORAGE_UPLOAD_TTL_SECONDS=600
OBJECT_STORAGE_DOWNLOAD_TTL_SECONDS=300

# Worker resource protection: maximum simultaneously running jobs per store.
WORKER_MAX_RUNNING_JOBS_PER_STORE=3
# Delay before a capacity-deferred job is re-dispatched through the Outbox.
WORKER_CONCURRENCY_DEFER_SECONDS=10

# Optional AI provider adapter. Disabled when AI_PROVIDER_* values are blank.
# The configured endpoint must implement the Store Operator v1 JSON provider contract.
# Use HTTPS for remote endpoints. Configure only capabilities actually supported by the model.
AI_PROVIDER_ID=
AI_PROVIDER_DISPLAY_NAME=
AI_PROVIDER_BASE_URL=
# Secret reference only; never put the API key itself in this file or in the database.
# Example: env://AI_PROVIDER_API_KEY (inject AI_PROVIDER_API_KEY via the runtime secret manager).
AI_PROVIDER_SECRET_REF=
AI_PROVIDER_REGION=
AI_PROVIDER_TIMEOUT_SECONDS=45
AI_PROVIDER_TEXT_MODELS=
AI_PROVIDER_IMAGE_MODELS=
AI_PROVIDER_VISION_MODELS=
AI_PROVIDER_OCR_MODELS=
AI_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=5
AI_PROVIDER_CIRCUIT_RESET_SECONDS=30
